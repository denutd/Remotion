# Salin file ini menjadi `.env` lalu isi API key ElevenLabs kamu.
# Dapatkan di: https://elevenlabs.io -> Profile -> API Keys
# PENTING: Jangan pernah commit file `.env` ke GitHub!

# Opsi 1: Satu API Key
ELEVENLABS_API_KEY=

# Opsi 2: Banyak API Key (Auto-Failover jika kuota habis)
# Opsi 2A (Dipisah koma):
# ELEVENLABS_API_KEYS=key1, key2, key3, key4

# Opsi 2B (Per baris / bernomor):
# ELEVENLABS_API_KEY_1=key1
# ELEVENLABS_API_KEY_2=key2
# ELEVENLABS_API_KEY_3=key3
# ELEVENLABS_API_KEY_4=key4
